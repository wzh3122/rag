# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend / CORS
FRONTEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Auth placeholder
ENABLE_AUTH=false
API_AUTH_TOKEN=change_me

# Rate limit
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Database
DATABASE_URL=sqlite:///./data/legal_agent_rag.db
# DATABASE_URL=postgresql+psycopg://legal_user:change_me@localhost:5432/legal_agent_rag

# LLM configuration
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# Embedding configuration
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://your-embedding-api.example.com
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60

# Reranker configuration
RERANKER_PROVIDER=openai_compatible
RERANKER_API_KEY=your_reranker_api_key_here
RERANKER_BASE_URL=https://your-reranker-api.example.com
RERANKER_MODEL=your-reranker-model
RERANKER_TIMEOUT_SECONDS=60

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_articles_dev

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=legal_articles_keyword_dev

# RAG behavior
RAG_INDEX_READY=false
RAG_STRICT_MODE=true

# Agent workflow
MAX_RETRY_TIMES=2

# Trace
ENABLE_AGENT_TRACE=true
TRACE_SAVE_RAW_INPUT=false
TRACE_SAVE_RAW_OUTPUT=false
TRACE_MAX_TEXT_LENGTH=1000

# Chat history
SAVE_CHAT_HISTORY=true
SAVE_CHAT_HISTORY_IN_PRODUCTION=false
SAVE_ACCUMULATED_FACTS=true

# Tests
RUN_INTEGRATION_TESTS=false

